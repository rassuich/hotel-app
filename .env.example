# Copy to .env (or set in your process manager). Nothing here is required for local demo use.

# --- Server ---
PORT=3000
# SQLite file on persistent local storage (only the backend touches it).
DATABASE_PATH=./data/palace.sqlite
# Public origin used to build private activation QR links. Must be the HTTPS origin guests reach.
PUBLIC_BASE_URL=https://guest.example.invalid
# Set in production. Enables Secure cookies (requires HTTPS).
NODE_ENV=production
# true when running behind a reverse proxy that terminates TLS (needed for correct client IPs / rate limits).
TRUST_PROXY=false
# COOKIE_SECURE=true

# --- Ordering scope ---
# Properties allowed to receive requests (initial release: Palace only).
ORDERING_PROPERTIES=palace-anfa
# Hours a checked-out device keeps the restricted post-stay (bill-area) capability. 0 = sign out at checkout.
POST_STAY_ACCESS_HOURS=72
# Optional explicit rule: block ordering N hours after the SCHEDULED departure even if not yet checked out.
# Leave empty (default) so only reception's actual checkout stops ordering.
SCHEDULED_DEPARTURE_CUTOFF_HOURS=
GUEST_SESSION_DAYS=30
STAFF_SESSION_HOURS=336

# Secret used to HMAC the typed validation codes. If unset, one is generated once into
# activation-code.secret next to the database file. Back it up with the database: without it,
# existing typed codes stop working (QR codes keep working; reception can reissue codes).
ACTIVATION_CODE_SECRET=

# --- Rate limits (failed attempts per IP, per window) ---
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_ACTIVATION_MAX=20
RATE_LIMIT_LOGIN_MAX=20

# --- Integrations ---
# PMS adapter: "manual" (reception enters stay events). "pluriel" is intentionally NOT implemented yet
# and refuses to start until real documentation/credentials exist.
PMS_ADAPTER=manual
# Web push (optional). Generate with: npm run push:generate-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:it@example.invalid

# --- Demo seed passwords (only used by db:seed-demo / db:reset-demo) ---
SEED_ROOM_SERVICE_PASSWORD=
SEED_RECEPTION_PASSWORD=
SEED_ADMIN_PASSWORD=
